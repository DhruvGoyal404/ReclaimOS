# ---------------------------------------------------------------------------
# ReclaimOS environment. Copy to .env and fill in. NEVER commit .env.
# Phases 0-1 (generator + eval harness) need NONE of these; every value below
# has a safe default or is only read by the live-gateway / LLM slices.
# ---------------------------------------------------------------------------

# --- Razorpay (TEST MODE ONLY — keys must start with rzp_test_) -------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- LLM (explanation + message drafting ONLY — never the money path) -------
ANTHROPIC_API_KEY=
RECLAIMOS_LLM_MODEL=claude-sonnet-5

# --- Storage ----------------------------------------------------------------
# SQLite is the default and requires no services. Point at Postgres to use the
# `full` docker-compose profile instead.
RECLAIMOS_DATABASE_URL=sqlite:///./data/reclaimos.db
# RECLAIMOS_DATABASE_URL=postgresql://reclaimos:reclaimos@localhost:5432/reclaimos
RECLAIMOS_REDIS_URL=

# --- Policy knobs (see docs/decisions/ADR-0003) -----------------------------
RECLAIMOS_MAX_ATTEMPTS=4
RECLAIMOS_HITL_THRESHOLD_PAISE=500000

# --- Observability ----------------------------------------------------------
RECLAIMOS_TRACE_DIR=./data/traces
