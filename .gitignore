# Secrets — never commit
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated data & run artifacts
# ...but data/live/ IS committed: the recorded transcript is the evidence the
# live slice happened at all. It contains test-mode ids only, scrubbed.
!data/live/
# SQLite databases are local state, and WAL/SHM sidecars come with them.
data/*.db
data/*.db-wal
data/*.db-shm
data/synthetic/*.jsonl
data/synthetic/*.world.json
data/runs/
# ...except the held-out read log, which is the audit trail for the seal.
!data/runs/held-out-reads.log
!data/synthetic/sample.jsonl
!data/synthetic/MANIFEST.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
